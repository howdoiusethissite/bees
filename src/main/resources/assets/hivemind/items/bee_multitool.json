{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "hivemind:tool_mode",
    "cases": [
      {
        "when": "axe",
        "model": {
          "type": "minecraft:model",
          "model": "hivemind:item/bee_multitool_axe"
        }
      },
      {
        "when": "shovel",
        "model": {
          "type": "minecraft:model",
          "model": "hivemind:item/bee_multitool_shovel"
        }
      },
      {
        "when": "hoe",
        "model": {
          "type": "minecraft:model",
          "model": "hivemind:item/bee_multitool_hoe"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "hivemind:item/bee_multitool_sword"
    }
  }
}
